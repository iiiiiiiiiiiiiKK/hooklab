{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hooklab",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hooklab-db",
      "database_id": "c0ff9630-39e7-4305-a2b0-6f54801fb4f2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_REPLAY_HOSTS": "",
    "ALLOWED_REPLAY_PORTS": ""
  }
}
