# HookLab environment variables
#
# Copy to `.dev.vars` for local `wrangler dev`, and set the same names as
# Worker secrets/vars for production:
#   npx wrangler secret put IP_HASH_SECRET
#
# No third-party API keys are required. Never commit real values.

# Salt used when hashing client IPs for rate limits (hex/base64 string).
IP_HASH_SECRET=change-me-to-a-long-random-string

# Optional: restrict replay to specific hosts (comma separated).
# Empty means "any public host that passes the SSRF checks".
ALLOWED_REPLAY_HOSTS=

# Optional: extra ports allowed for replay on top of 80/443/8080/8443.
ALLOWED_REPLAY_PORTS=

# Optional: set to 1 to include error messages (never payloads) in 500 responses.
# Leave unset in production.
DEBUG_ERRORS=

# Bindings supplied by wrangler.jsonc (listed here for reference only):
# DB      -> Cloudflare D1 database
# ASSETS  -> static asset directory (dist/)
